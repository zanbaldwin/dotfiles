// Noctalia is started by the noctalia.service user unit, not from here.
// Reference: https://docs.noctalia.dev/noctalia/compositor-settings/niri/

// Show Noctalia's blurred, tinted wallpaper copy behind the overview.
// Needs `[backdrop] enabled = true` in the Noctalia config.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Noctalia publishes blur regions for its surfaces automatically. Without
// `xray false` the blur samples the wallpaper instead of the windows behind.
layer-rule {
    match namespace="^noctalia-"
    background-effect {
        xray false
    }
}

// Float the Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

clipboard {
    disable-primary
}
