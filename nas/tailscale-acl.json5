{
    // Define grants that govern access for users, groups, autogroups, tags,
    // Tailscale IP addresses, and subnet ranges.
    "grants": [
        // ====================================================================
        // DNS Access - Everyone needs DNS
        // ====================================================================
        {
            "src": [
                "*",
            ],
            "dst": [
                "tag:dns",
            ],
            "ip": [
                "udp:53",
                "tcp:53",
            ],
        },
        // ====================================================================
        // LAN Subnet Access via Subnet Router (TrueNAS)
        // ====================================================================
        // All clients can access HTTPS services on LAN (proxied through NPM).
        {
            "src": [
                "tag:client",
            ],
            "dst": [
                "tag:nas",
                "192.168.1.0/24",
            ],
            "ip": [
                "tcp:443",
                "tcp:80",
            ],
        },
        // Only computers can access NFS shares remotely.
        {
            "src": [
                "tag:nfs",
            ],
            "dst": [
                "tag:nas",
                "192.168.1.0/24",
            ],
            "ip": [
                "tcp:2049",
                "udp:2049",
            ],
            "srcPosture": [
                "posture:upToDate",
            ],
        },
        // Devices allowed to mount SMB shares (iPadOS Files, laptops).
        // Port 139 (NetBIOS) is deliberately omitted; SMB2/3 clients use 445 only.
        {
            "src": [
                "tag:smb",
            ],
            "dst": [
                "tag:nas",
                "192.168.1.0/24",
            ],
            "ip": [
                "tcp:445",
            ],
            "srcPosture": [
                "posture:upToDate",
            ],
        },
        // Remote clients can push+pull from Git server using SSH.
        {
            "src": [
                "tag:remote",
            ],
            "dst": [
                "tag:nas",
                "192.168.1.0/24",
            ],
            "ip": [
                "tcp:484",
            ],
            "srcPosture": [
                "posture:upToDate",
            ],
        },
        // ====================================================================
        // Device Communication
        // ====================================================================
        // Client devices can communicate with each other
        // (e.g., SSH from laptop to desktop, clipboard sync, etc.)
        {
            "src": [
                "tag:client",
            ],
            "dst": [
                "tag:client",
            ],
            "ip": [
                "*",
            ],
        },
        // Remote clients can SSH into infrastructure devices for maintanence.
        {
            "src": [
                "tag:remote",
            ],
            "dst": [
                "tag:infra",
                "192.168.1.0/24",
            ],
            "ip": [
                "tcp:22",
            ],
        },
        // ====================================================================
        // Family (invited users; their devices are untagged)
        // ====================================================================
        // Web services only, reached via the NAS's Tailscale IP. Deliberately
        // no 192.168.1.0/24 here. Note the subnet route still installs on
        // their devices (route approval is separate from grants), so narrow
        // TS_ROUTES before inviting anyone whose home LAN is 192.168.1.0/24.
        // Per-service restriction is not possible at this layer: every
        // *.lan.zanbaldwin.com name is the same IP and port. Use app logins
        // and NPM access lists for that.
        {
            "src": [
                "group:family",
            ],
            "dst": [
                "tag:nas",
            ],
            "ip": [
                "tcp:443",
            ],
        },
        // ====================================================================
        // Exit Node
        // ====================================================================
        // Remote clients may route all internet traffic via the NAS exit node.
        // Only tagOwners (Zan) can apply tag:remote, so invited users' untagged
        // devices never match. Do not widen the src to autogroup:member.
        {
            "src": [
                "tag:remote",
            ],
            "dst": [
                "autogroup:internet",
            ],
            "ip": [
                "*",
            ],
        },
    ],
    // Define device posture rules requiring devices to meet
    // certain criteria to access parts of your system.
    "postures": {
        "posture:computer": [
            "node:os IN ['linux', 'macos', 'windows']",
        ],
        "posture:mobile": [
            "node:os IN ['ios', 'android']",
        ],
        // Do not require node:tsAutoUpdate: it is always false on App Store
        // and Play Store clients and inside containers.
        "posture:upToDate": [
            "node:tsReleaseTrack == 'stable'",
        ],
    },
    // Groups of invited users. The free plan allows 3 groups.
    "groups": {
        // Replace with the family members' login emails once invited.
        // Zan is a placeholder so the group validates: Zan's devices are all
        // tagged, and tagged devices never match user- or group-based rules.
        "group:family": [
            "hello@zanbaldwin.com",
        ],
    },
    // Define the tags which can be applied to devices and by which users.
    // Note: "ssh" section omitted - Tailscale SSH not available on containerized deployments.
    "tagOwners": {
        // For human-operated machines I own and trust
        "tag:client": [
            "hello@zanbaldwin.com",
        ],
        // For clients that may access from outside the home LAN
        "tag:remote": [
            "hello@zanbaldwin.com",
        ],
        // For always-on LAN infrastructure
        "tag:infra": [
            "hello@zanbaldwin.com",
        ],
        // For NAS-specific ACLs
        "tag:nas": [
            "hello@zanbaldwin.com",
        ],
        // For Pi-hole / DNS resolvers
        "tag:dns": [
            "hello@zanbaldwin.com",
        ],
        // For human-operated machines I do NOT own and trust (future)
        "tag:guest": [
            "hello@zanbaldwin.com",
        ],
        // Allow devices remote-access to NFS shares
        "tag:nfs": [
            "hello@zanbaldwin.com",
        ],
        // Allow devices remote-access to SMB shares
        "tag:smb": [
            "hello@zanbaldwin.com",
        ],
    },
    "autoApprovers": {
        "routes": {
            "192.168.1.0/24": [
                "tag:nas",
            ],
        },
        "exitNode": [
            "tag:nas",
        ],
    },
    // Tailscale is running in containers on the majority of devices, so
    // Tailscale SSH wouldn't work any way. Don't define "ssh" section.
    // Test access rules every time they're saved.
    "tests": [
        // Clients should always have access to services and DNS
        {
            "src": "tag:client",
            "accept": [
                "tag:dns:53",
                "tag:nas:443",
                "tag:nas:80",
            ],
        },
        // Only SMB-tagged devices reach the file server; plain clients must not.
        {
            "src": "tag:smb",
            "accept": [
                "tag:nas:445",
            ],
        },
        {
            "src": "tag:client",
            "deny": [
                "tag:nas:445",
            ],
        },
        // Family reaches the web proxy and nothing else on the NAS.
        {
            "src": "group:family",
            "accept": [
                "tag:nas:443",
            ],
            "deny": [
                "tag:nas:22",
                "tag:nas:80",
                "tag:nas:445",
                "tag:nas:484",
                "tag:nas:2049",
            ],
        },
    ],
}
